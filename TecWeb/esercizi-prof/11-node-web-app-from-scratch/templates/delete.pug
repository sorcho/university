extends ./base-layout.pug

block content
    form(action="/delete" method="POST")
        button(class="btn btn-primary w-100" type="submit") Delete To-do
    .test
        each item in todoItems
            input#item.id(type="radio" name="choice")
            label(for="item.id")=item.todo
            br
        else 
            p(class="text-danger") The To-do list is currently empty! Add the first in 
            a(href="/todos")
            | .
    
    