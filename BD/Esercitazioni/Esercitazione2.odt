    <text:sequence-decl text:display-outline-level="0" text:name="Figure"/>
   </text:sequence-decls>
   <text:p text:style-name="P3">Esercitazione AR e SQL</text:p>
   <text:list xml:id="list291492328" text:style-name="L1">
    <text:list-item>
     <text:p text:style-name="P13">Il nome di tutte le sale di Pisa</text:p>
    </text:list-item>
   </text:list>
   <text:list xml:id="list2198040943" text:style-name="L2">
    <text:list-item>
     <text:list>
      <text:list-item>
       <text:p text:style-name="P14">AR:<text:line-break/><text:span text:style-name="T1">π</text:span><text:span text:style-name="T14">&lt;nome&gt;</text:span><text:span text:style-name="T23">(σ</text:span><text:span text:style-name="T14">&lt;città = ‘Pisa’&gt;</text:span><text:span text:style-name="T23">(Sala))</text:span></text:p>
      </text:list-item>
      <text:list-item>
       <text:p text:style-name="P14">SQL:<text:line-break/>SELECT s.nome<text:line-break/>FROM sala s<text:line-break/>WHERE s.città = ‘Pisa’;</text:p>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:list xml:id="list213054747232892" text:continue-list="list291492328" text:style-name="L1">
    <text:list-item>
     <text:p text:style-name="P13">Il titolo dei film di F. Fellini prodotti dopo il 1960</text:p>
    </text:list-item>
   </text:list>
   <text:list xml:id="list486589149" text:style-name="L3">
    <text:list-item>
     <text:list>
      <text:list-item>
       <text:p text:style-name="P15">AR:<text:line-break/><text:span text:style-name="T1">π</text:span><text:span text:style-name="T14">&lt;titolo&gt;</text:span><text:span text:style-name="T23">(σ</text:span><text:span text:style-name="T14">&lt;regista = ‘F. Fellini’ AND annoproduzione &gt; 1960&gt;</text:span><text:span text:style-name="T23">(Film))</text:span></text:p>
      </text:list-item>
      <text:list-item>
       <text:p text:style-name="P15">SQL:<text:line-break/>SELECT f.titolo<text:line-break/>FROM film f<text:line-break/>WHERE f.regista = ‘F. Fellini’ AND f.annoproduzione &gt; 1960;</text:p>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:list xml:id="list213056117390974" text:continue-list="list213054747232892" text:style-name="L1">
    <text:list-item>
     <text:p text:style-name="P13">Il titolo e la durata dei film di fantascienza giapponesi o francesi prodotti dopo il 1990</text:p>
    </text:list-item>
   </text:list>
   <text:list xml:id="list1542977143" text:style-name="L4">
    <text:list-item>
     <text:list>
      <text:list-item>
       <text:p text:style-name="P26"><text:span text:style-name="T26">AR:<text:line-break/></text:span><text:span text:style-name="T2">π</text:span><text:span text:style-name="T15">&lt;titolo, durata&gt;</text:span><text:span text:style-name="T7">(σ</text:span><text:span text:style-name="T15">&lt;</text:span><text:span text:style-name="T16">genere = ‘fantascienza’ AND annoproduzione &gt; 1990 AND (nazionalità = ‘francese’ OR nazionalità = ‘giapponese’)</text:span><text:span text:style-name="T15">&gt;</text:span><text:span text:style-name="T7">(</text:span><text:span text:style-name="T8">Film</text:span><text:span text:style-name="T7">))</text:span></text:p>
      </text:list-item>
      <text:list-item>
       <text:p text:style-name="P27"><text:span text:style-name="T26">SQL:<text:line-break/></text:span><text:span text:style-name="T28">SELECT f.titolo, f.durata<text:line-break/>FROM film f<text:line-break/></text:span><text:span text:style-name="T29">WHERE f.genere = ‘fantascienza’ AND f.annoproduzione &gt; 1990 AND (f.nazionalità = ‘francese’ OR f.nazionalità = ‘giapponese’);</text:span></text:p>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:list xml:id="list213054919597629" text:continue-list="list213056117390974" text:style-name="L1">
    <text:list-item>
     <text:p text:style-name="P13">Il titolo dei film di fantascienza giapponesi prodotti dopo il 1990 oppure francesi</text:p>
    </text:list-item>
   </text:list>
   <text:list xml:id="list1118321886" text:style-name="L5">
    <text:list-item>
     <text:list>
      <text:list-item>
       <text:p text:style-name="P16">AR:<text:line-break/><text:span text:style-name="T1">π</text:span><text:span text:style-name="T14">&lt;titolo&gt;</text:span><text:span text:style-name="T6">(σ</text:span><text:span text:style-name="T14">&lt;</text:span><text:span text:style-name="T17">(genere = ‘fantascienza’ AND annoproduzione &gt; 1990 AND nazionalità = ‘giapponese’) OR nazionalità = ‘francese’</text:span><text:span text:style-name="T14">&gt;</text:span><text:span text:style-name="T6">(</text:span><text:span text:style-name="T9">Film</text:span><text:span text:style-name="T6">))</text:span></text:p>
      </text:list-item>
      <text:list-item>
       <text:p text:style-name="P17">SQL:<text:line-break/><text:span text:style-name="T30">SELECT f.titolo<text:line-break/>FROM film f<text:line-break/>WHERE f.nazionalità = ‘francese’ OR (f.genere = </text:span><text:soft-page-break/><text:span text:style-name="T30">‘fantascienza’ AND f.annoproduzione &gt; 1990 AND f.nazionalità = ‘giapponese’);</text:span></text:p>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:list xml:id="list213056018322690" text:continue-list="list213054919597629" text:style-name="L1">
    <text:list-item>
     <text:p text:style-name="P18">I titolo dei film dello stesso regista di “Casablanca”</text:p>
    </text:list-item>
   </text:list>
   <text:list xml:id="list3195469132" text:style-name="L6">
    <text:list-item>
     <text:list>
      <text:list-item>
       <text:p text:style-name="P19">AR:<text:line-break/><text:span text:style-name="T31">cb ← </text:span><text:span text:style-name="T3">π</text:span><text:span text:style-name="T18">&lt;regista&gt;</text:span><text:span text:style-name="T10">(σ</text:span><text:span text:style-name="T18">&lt;titolo = ‘Casablanca’&gt;</text:span><text:span text:style-name="T10">(Film))</text:span><text:line-break/><text:span text:style-name="T1">π</text:span><text:span text:style-name="T14">&lt;titolo&gt;</text:span><text:span text:style-name="T6">(σ</text:span><text:span text:style-name="T14">&lt;</text:span><text:span text:style-name="T18">regista = cb</text:span><text:span text:style-name="T14">&gt;</text:span><text:span text:style-name="T10">(Film)</text:span><text:span text:style-name="T6">)</text:span></text:p>
      </text:list-item>
      <text:list-item>
       <text:p text:style-name="P19">SQL:<text:line-break/>SELECT f.titolo<text:line-break/>FROM film f<text:line-break/>WHERE f.regista = (<text:line-break/>SELECT f2.regista<text:line-break/>FROM film f2<text:line-break/>WHERE f2.titolo = ‘Casablanca’);</text:p>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:list xml:id="list213054643178674" text:continue-list="list213056018322690" text:style-name="L1">
    <text:list-item>
     <text:p text:style-name="P18">Il titolo ed il genere dei film proiettati il giorno di Natale 2004</text:p>
    </text:list-item>
   </text:list>
   <text:list xml:id="list2276630928" text:style-name="L7">
    <text:list-item>
     <text:list>
      <text:list-item>
       <text:p text:style-name="P20">AR:<text:line-break/><text:span text:style-name="T4">π</text:span><text:span text:style-name="T19">&lt;titolo, genere&gt;</text:span><text:span text:style-name="T11">(σ</text:span><text:span text:style-name="T19">&lt;dataproiezione = ‘2004-12-25’&gt;</text:span><text:span text:style-name="T11">(Film ⨝</text:span><text:span text:style-name="T19">&lt;film.codfilm = proiezione.codfilm&gt;</text:span><text:span text:style-name="T11"> Proiezione))</text:span></text:p>
      </text:list-item>
      <text:list-item>
       <text:p text:style-name="P20">SQL:<text:line-break/>SELECT <text:span text:style-name="T32">f.titolo, f.genere</text:span><text:line-break/>FROM <text:span text:style-name="T32">film f, proiezione p</text:span><text:line-break/>WHERE <text:span text:style-name="T32">f.codfilm = p.codfilm AND p.dataproiezione = ‘2004-12-25’;</text:span></text:p>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:list xml:id="list213056252487676" text:continue-list="list213054643178674" text:style-name="L1">
    <text:list-item>
     <text:p text:style-name="P18">Il titolo ed il genere dei film proiettati a Napoli il giorno di Natale 2004</text:p>
    </text:list-item>
   </text:list>
   <text:list xml:id="list2300103960" text:style-name="L8">
    <text:list-item>
     <text:list>
      <text:list-item>
       <text:p text:style-name="P21">AR: <text:line-break/><text:span text:style-name="T33">f ← </text:span><text:span text:style-name="T5">π</text:span><text:span text:style-name="T20">&lt;*&gt;</text:span><text:span text:style-name="T12">(Film)<text:line-break/>p ← </text:span><text:span text:style-name="T5">π</text:span><text:span text:style-name="T20">&lt;*&gt;</text:span><text:span text:style-name="T12">(Proiezione)<text:line-break/>s ← </text:span><text:span text:style-name="T5">π</text:span><text:span text:style-name="T20">&lt;*&gt;</text:span><text:span text:style-name="T12">(Sala)<text:line-break/></text:span><text:span text:style-name="T5">π</text:span><text:span text:style-name="T20">&lt;titolo, genere&gt;</text:span><text:span text:style-name="T12">(σ</text:span><text:span text:style-name="T20">&lt;città = ‘Napoli’&gt;</text:span><text:span text:style-name="T12">(f </text:span><text:span text:style-name="T11">⨝</text:span><text:span text:style-name="T19">&lt;</text:span><text:span text:style-name="T20">f.codfilm = p.codfilm</text:span><text:span text:style-name="T19">&gt;</text:span><text:span text:style-name="T11"> </text:span><text:span text:style-name="T12">p) </text:span><text:span text:style-name="T11">⨝</text:span><text:span text:style-name="T19">&lt;</text:span><text:span text:style-name="T20">p.codsala = s.codsala</text:span><text:span text:style-name="T19">&gt;</text:span><text:span text:style-name="T11"> </text:span><text:span text:style-name="T12">s)</text:span></text:p>
      </text:list-item>
      <text:list-item>
       <text:p text:style-name="P22">SQL:<text:line-break/>SELECT f.titolo, f.genere<text:line-break/>FROM film f<text:line-break/>INNER JOIN proiezione p ON f.codfilm = p.codfilm<text:line-break/>INNER JOIN sala s ON p.codsala = s.codsala<text:line-break/>WHERE s.città = ‘Napoli’;</text:p>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:list xml:id="list213054776999866" text:continue-list="list213056252487676" text:style-name="L1">
    <text:list-item>
     <text:p text:style-name="P13"><text:soft-page-break/>I nomi delle sale di Napoli in cui il giorno di Natale 2004 è stato proiettato un film con R.Williams</text:p>
    </text:list-item>
   </text:list>
   <text:list xml:id="list1531237568" text:style-name="L9">
    <text:list-item>
     <text:list>
      <text:list-item>
       <text:p text:style-name="P24">AR:<text:line-break/><text:span text:style-name="T35">joins ← </text:span><text:span text:style-name="T13">π</text:span><text:span text:style-name="T19">&lt;*&gt;</text:span><text:span text:style-name="T35">(((Sala </text:span><text:span text:style-name="T11">⨝</text:span><text:span text:style-name="T19">&lt;</text:span><text:span text:style-name="T21">s.codsala = p.codsala</text:span><text:span text:style-name="T19">&gt;</text:span><text:span text:style-name="T11"> </text:span><text:span text:style-name="T13">Proiezione) </text:span><text:span text:style-name="T11">⨝</text:span><text:span text:style-name="T19">&lt;</text:span><text:span text:style-name="T21">p.codfilm = f.codfilm</text:span><text:span text:style-name="T19">&gt;</text:span><text:span text:style-name="T11"> </text:span><text:span text:style-name="T13">Film) </text:span><text:span text:style-name="T11">⨝</text:span><text:span text:style-name="T19">&lt;</text:span><text:span text:style-name="T21">f.codfilm = r.codfilm</text:span><text:span text:style-name="T19">&gt;</text:span><text:span text:style-name="T11"> </text:span><text:span text:style-name="T13">Recita) </text:span><text:span text:style-name="T11">⨝</text:span><text:span text:style-name="T19">&lt;</text:span><text:span text:style-name="T21">r.codattore = a.codattore</text:span><text:span text:style-name="T19">&gt;</text:span><text:span text:style-name="T11"> </text:span><text:span text:style-name="T13">Attore<text:line-break/></text:span><text:span text:style-name="T13">π</text:span><text:span text:style-name="T19">&lt;</text:span><text:span text:style-name="T21">nome</text:span><text:span text:style-name="T19">&gt;</text:span><text:span text:style-name="T24">(</text:span><text:span text:style-name="T24">σ</text:span><text:span text:style-name="T21">&lt;dataproiezione = ‘2004-12-25’ AND nome = ‘R. Williams’&gt;</text:span><text:span text:style-name="T24">(joins))</text:span></text:p>
      </text:list-item>
      <text:list-item>
       <text:p text:style-name="P23">SQL:<text:line-break/>SELECT s.nome<text:line-break/>FROM sala s<text:line-break/>INNER JOIN proiezione p ON s.codsala = p.codsala<text:line-break/>INNER JOIN film f ON p.codfilm = f.codfilm<text:line-break/>INNER JOIN recita r ON f.codfilm = r.codfilm<text:line-break/>INNER JOIN attore a ON r.codattore = a.codattore<text:line-break/>WHERE p.dataproiezione = ‘<text:span text:style-name="T34">2004-12-25</text:span>’ <text:span text:style-name="T34">AND a.nome = ‘R. Williams’;</text:span></text:p>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:list xml:id="list213055145017552" text:continue-list="list213054776999866" text:style-name="L1">
    <text:list-item>
     <text:p text:style-name="P13">Il titolo dei film in cui recita M. Mastroianni oppure S.Loren</text:p>
    </text:list-item>
   </text:list>
   <text:list xml:id="list3373939217" text:style-name="L10">
    <text:list-item>
     <text:list>
      <text:list-item>
       <text:p text:style-name="P25">AR:</text:p>
      </text:list-item>
      <text:list-item>
       <text:p text:style-name="P25">SQL:<text:line-break/>SELECT f.titolo<text:line-break/>FROM film f<text:line-break/>WHERE</text:p>
      </text:list-item>
     </text:list>
    </text:list-item>
   </text:list>
   <text:list xml:id="list213055609558984" text:continue-list="list213055145017552" text:style-name="L1">
    <text:list-item>
     <text:p text:style-name="P13">a</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P13">a</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P13">a</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P13">a</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P13">a</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P13">a</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P13">a</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P13">a</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P13">a</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P13">a</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P13">a</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P13">a</text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P4"/>
  </office:text>
 </office:body>
